# --- core -------------------------------------------------------------
BRAND_NAME=Hitchload
SUPPORT_EMAIL=support@hitchload.ca
NODE_ENV=production
PORT=8080
# public HTTPS address of this server (used in links and file URLs)
PUBLIC_URL=https://hitchload.ca
DATABASE_URL=postgres://hitchload:CHANGE_ME@db-host:5432/hitchload
# openssl rand -base64 48
JWT_SECRET=
# 32 random bytes, base64: openssl rand -base64 32   (encrypts SIN/BN; never lose or change it)
DATA_ENCRYPTION_KEY=
# comma-separated phones that get admin access, E.164
ADMIN_PHONES=+17800000001
CORS_ORIGINS=*

# --- Stripe (payments, Connect payouts, Identity) ----------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Twilio (SMS codes + PIN SMS to recipients) ------------------------
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=VA...
TWILIO_FROM_NUMBER=+1...

# --- Email (receipts, confirmations, route alerts): resend or postmark ---
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=Hitchload <no-reply@hitchload.ca>

# --- Browser push notifications: generate once with `npm run vapid` ------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@hitchload.ca

# --- Maps on the website ----------------------------------------------
# Google Places address search (browser key restricted to your domain). Empty = street + city list.
GOOGLE_MAPS_BROWSER_KEY=
# Map tiles. tile.openstreetmap.org is fine for launch but not for heavy traffic: switch to MapTiler/Stadia/Thunderforest.
MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# --- Expo push (mobile app, later) -------------------------------------
EXPO_ACCESS_TOKEN=

# --- File storage (S3 or S3-compatible). Empty = local disk (dev only) --
S3_BUCKET=
S3_REGION=ca-central-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
LOCAL_STORAGE_DIR=./uploads

# --- Business rules (defaults shown; fractions, cents, seconds) ---------
CLIENT_FEE_RATE=0.05
DRIVER_FEE_RATE=0.05
INSURANCE_RATE=0.015
INSURANCE_MIN_CENTS=300
BASIC_CARGO_LIMIT_CENTS=100000
BASIC_INSURED_CARGO_LIMIT_CENTS=500000
PRO_WINDOW_CITY_SEC=150
PRO_WINDOW_INTERCITY_SEC=1800
TRIP_REQUEST_TIMEOUT_SEC=1800
TRIP_DISCOUNT=0.2
CANCEL_EARLY_DRIVER_RATE=0.05
CANCEL_EARLY_PLATFORM_RATE=0.05
CANCEL_LATE_DRIVER_RATE=0.3
CANCEL_LATE_PLATFORM_RATE=0.1
CANCEL_LATE_HOURS=24
NO_SHOW_DRIVER_RATE=0.4
NO_SHOW_PLATFORM_RATE=0.1
MAX_DRIVER_DROPS_30D=3
TZ_DISPLAY=America/Edmonton
